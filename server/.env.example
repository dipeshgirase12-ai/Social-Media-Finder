# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (MongoDB Atlas or local) ──────────────────
MONGODB_URI=

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── External platform credentials (optional) ───────────
# Personal-access tokens raise API rate limits. The app works without them.
GITHUB_TOKEN=
GITLAB_TOKEN=
NPM_API_URL=https://registry.npmjs.org

# ── Rate limits (requests per window) ──────────────────
SEARCH_RATE_LIMIT=20
SEARCH_RATE_WINDOW_MINUTES=15
AUTH_RATE_LIMIT=10
API_RATE_LIMIT=60
WEBSITE_RATE_LIMIT=10

# ── Cache TTLs (seconds) ───────────────────────────────
CACHE_TTL_SECONDS=600
WEBSITE_CACHE_TTL_SECONDS=1800

# ── Behaviour ──────────────────────────────────────────
# When true, providers return clearly-labelled synthetic demo data.
DEMO_MODE=false

# Comma-separated list of admin emails (registers as role=admin)
ADMIN_EMAILS=
